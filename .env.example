# Optional: if omitted, the deterministic fallback planner is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ephemeral session controls for uploaded/generated presentation artifacts.
VENUE_SESSION_TTL_SECONDS=2700
VENUE_MAX_SESSIONS=24
VENUE_PER_CLIENT_SESSIONS=8
# Set only to directly connected proxy IPs configured by the deployment owner.
VENUE_TRUSTED_PROXY_IPS=

# Optional process-local session workspace override (useful for isolated test runners)
VENUE_SESSION_ROOT=

# Runtime fairness / resource bounds.
VENUE_MAX_CONCURRENT_RENDERS=1
VENUE_RENDER_QUEUE_TIMEOUT_SECONDS=8
VENUE_MAX_REQUEST_BODY_BYTES=23068672
VENUE_READINESS_PROBE_TTL_SECONDS=300
VENUE_READINESS_SUCCESS_GRACE_SECONDS=900

# Bounded optional Gemini planner network behavior. Timeout is milliseconds.
GEMINI_TIMEOUT_MS=10000
GEMINI_CIRCUIT_COOLDOWN_SECONDS=60

# Competition V1 must run as exactly one worker / one deployment replica because
# session state is process-local. Do not set WEB_CONCURRENCY or UVICORN_WORKERS > 1.

# Build identity displayed by health/UI; set this to the final tagged release.
VENUE_RELEASE_ID=deckfit-nextfounders-rc5-local
